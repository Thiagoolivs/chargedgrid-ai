# Copie para chargegrid-ai/.env e preencha. NUNCA comite o .env preenchido.

# Groq - modelo atual (baseline e agente)
GROQ_API_KEY=

# Google AI Studio - segundo modelo do comparativo (Gemini Flash)
GOOGLE_API_KEY=

# Selecao de modelo do agente (agent_core/config.py)
# MODEL_PROVIDER: groq | google
MODEL_PROVIDER=groq
MODEL_ID=llama-3.3-70b-versatile
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=1200
