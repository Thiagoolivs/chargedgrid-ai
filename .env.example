# Copie para chargegrid-ai/.env e preencha. NUNCA comite o .env preenchido.

# Groq - modelo atual (baseline e agente)
GROQ_API_KEY=

# Google AI Studio - segundo modelo do comparativo (Gemini Flash)
GOOGLE_API_KEY=

# Selecao de modelo do agente (agent_core/config.py)
# MODEL_PROVIDER: groq | google
# Padrao = modelo escolhido na secao 9 de docs/relatorio_modelos.md.
MODEL_PROVIDER=google
MODEL_ID=gemini-3.6-flash
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=1200
# Raciocinio interno do modelo (Gemini 3.x). Padrao 0 = desligado: o
# max_output_tokens e dividido com o raciocinio e a resposta sai truncada.
MODEL_THINKING=0
